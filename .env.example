# ── Supabase ────────────────────────────────────────────────────────────────
# Mismo proyecto que estudio-backend (tablas facturacion_users y clients).
SUPABASE_URL=
# service_role si se van a crear filas de facturacion_users desde /api/altas.
SUPABASE_API_KEY=

# ── Vault ───────────────────────────────────────────────────────────────────
# Los certificados se escriben en secret/data/certificate/<facturacion_users.id>
# con campos { cert, key }. Es lo que después lee estudio-backend para el DFE.
VAULT_ADDRESS=
VAULT_TOKEN=

PORT=3000

# ── /api/altas (módulo src/altas) ───────────────────────────────────────────
# El /api/scrapper original no usa nada de esto.

# Clave estática para que el orquestador masivo (estudio-backend,
# `pnpm crear:facturacion`) llame sin un JWT de Supabase. Si queda vacía,
# /api/altas sigue exigiendo Bearer de Supabase.
INTERNAL_API_KEY=

# false = con ventana visible. Conviene para la primera corrida y para los
# CUIT que quedaron marcados como "requiere intervención".
SCRAPPER_HEADLESS=true
# Milisegundos entre acciones cuando se mira la corrida en vivo.
SCRAPPER_SLOW_MO=0
# Chromium del sistema. En el Dockerfile: /usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=
# Timeout por defecto de los waitForSelector.
SCRAPPER_TIMEOUT_MS=20000
# Si el cert en Vault es más nuevo que esto, se reusa en vez de crear otro.
# Cada CSR de más deja un computador fiscal más en AFIP, y es lo que después
# hace elegir el equivocado en Administrador de Relaciones.
SCRAPPER_REUSE_CERT_DAYS=14
# Base de los directorios por corrida (uploads/downloads/capturas).
# Default: <cwd>/.altas/<cuit>/<timestamp>/
SCRAPPER_WORK_DIR=
# Formato del serialNumber del CSR. AFIP documenta "CUIT 20111111112" (con
# espacio); si alguna vez rechaza el CSR, probar con "CUIT{cuit}".
CSR_SERIAL_FORMAT=CUIT {cuit}
# Capturas en cada etapa, no sólo en los errores.
SCRAPPER_SHOTS_ALL=true

# sqlite con el historial de jobs de /api/altas (el del scrapper original
# sigue siendo :memory:).
JOBS_DB_PATH=data/jobs.sqlite
